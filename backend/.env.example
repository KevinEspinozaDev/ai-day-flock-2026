# Puerto HTTP (Railway lo inyecta automáticamente)
PORT=3000

# Conexión a Postgres (en Railway: referenciar ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vulnprio

# Secreto para firmar los JWT (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# Usuario administrador inicial (solo se crea si la tabla users está vacía)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_DISPLAY_NAME=Administrador

# true si Postgres requiere SSL (Railway usa red privada, normalmente false)
DATABASE_SSL=false
